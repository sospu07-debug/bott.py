# Binance read-only API credentials
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram numeric user IDs allowed to view Binance wallet (comma-separated)
BINANCE_ALLOWED_USER_IDS=

# Optional settings
BINANCE_API_BASE=https://api.binance.com
BINANCE_DB_PATH=binance_wallet.sqlite3
BINANCE_SYNC_SECONDS=300
